# 3awedlou web app — copy to .env and adjust per environment.
# NEVER put secrets here: everything in VITE_* is bundled into public JS.

# Symfony API base URL (the SAME backend the mobile app uses).
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Realtime transport endpoint (WebSocket/SSE). Empty = dashboards poll the
# REST API on an interval instead (honest polling, not fake realtime).
VITE_REALTIME_URL=

# development | production — shown in the UI footer, used for log verbosity.
VITE_ENVIRONMENT=development
